# ============ BACKEND ============
# SQLite (mặc định, chạy ngay không cần cài gì):
DATABASE_URL=sqlite:///./hatxoan.db
# PostgreSQL local:  postgresql+psycopg://postgres:postgres@localhost:5432/hatxoan
# Supabase:          postgresql+psycopg://postgres:<pass>@db.<ref>.supabase.co:5432/postgres

# LLM (tùy chọn — để trống sẽ dùng chế độ extractive fallback, RAG vẫn chạy)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB ngoài (không bắt buộc ở MVP — để trống = dùng BM25 in-process)
VECTOR_DB_URL=

# RAG tuning
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# Chat memory (false = client-side state)
ENABLE_CHAT_MEMORY=false

# CORS
CORS_ORIGINS=http://localhost:3000

# ============ FRONTEND ============
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL Zapworks WebAR — để trống thì /ar hiển thị thông báo chưa cấu hình (không crash)
NEXT_PUBLIC_AR_URL=
